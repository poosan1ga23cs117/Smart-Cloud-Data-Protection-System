# ============================================================
# Smart Cloud Data Protection System - Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit .env
# ============================================================

# --- Application ---
SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=true
DEV_MODE=true

# --- Database ---
# DATABASE_URL is optional. Leave it unset to use the automatic absolute
# path <project>/instance/database.db in config.py (works on any OS and
# the instance/ folder is created on startup). Set it only for a fixed
# location, e.g.:
#   DATABASE_URL=sqlite:////absolute/path/to/database.db

# --- Cookies (set COOKIE_SECURE=true behind HTTPS) ---
COOKIE_SECURE=false

# --- AWS S3 (create an IAM user with S3 policy; rotate keys regularly) ---
# On EC2 these can be injected directly by the platform instead of .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=smart-cloud-storage-zero-architecture

# --- Storage backend: "auto" | "s3" | "local" ---
#   auto  -> S3 when credentials + bucket are set, otherwise local uploads/
#   s3    -> always Amazon S3 (falls back to local if not configured)
#   local -> always use the local uploads/ folder (demo mode, no AWS)
STORAGE_BACKEND=auto

# --- Master Key (AES envelope encryption - 32 bytes hex = 64 chars) ---
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
MASTER_KEY=replace-with-64-hex-chars

# --- MFA ---
MFA_REQUIRED=true
OTP_TTL_SECONDS=300
# Max wrong OTP attempts before a new OTP is issued + sent.
OTP_MAX_ATTEMPTS=3
# Max manual OTP resends before the user must login again.
OTP_MAX_RESENDS=3
# Account unlock OTP expiry (10 minutes).
UNLOCK_OTP_TTL_SECONDS=600

# --- Account Lock ---
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION_MINUTES=30

# --- File fragmentation (bytes per fragment, default 4 MB) ---
FRAGMENT_SIZE_BYTES=4194304

# --- Email / SMTP (set MAIL_ENABLED=true when SMTP is configured) ---
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@smartcloud.local
ADMIN_EMAIL=admin@example.com
ADMIN_EMAILS=admin@example.com

# --- Rate limiting storage ---
RATELIMIT_STORAGE_URI=memory://

# --- Upload limits ---
MAX_CONTENT_LENGTH=52428800
